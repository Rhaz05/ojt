<div class="card shadow mb-4">
  <div
    class="card-header py-3 d-flex justify-content-between align-items-center"
  >
    <h6 class="m-0 font-weight-bold text-primary">Receipts</h6>
    <button type="button" class="btn btn-primary btn-sm" id="addBtn">
      <i class="fas fa-plus mr-1"></i>Add Order
    </button>
  </div>
  <div class="card-body">
    <div class="table-responsive">
      <table
        class="table table-bordered"
        id="orderTable"
        width="100%"
        cellspacing="0"
      >
        <thead>
          <tr>
            <th>Order Number</th>
            <th>Customer Name</th>
            <th>Order</th>
            <th>Mode of Payment</th>
            <th>Total</th>
          </tr>
        </thead>
        <tbody id="orderBody"></tbody>
      </table>
    </div>
  </div>
</div>

<div
  class="modal fade"
  id="testingModal"
  tabindex="-1"
  role="dialog"
  aria-labelledby="testingModalTitle"
  aria-hidden="true"
>
  <div class="modal-dialog modal-dialog-centered" role="document">
    <div class="modal-content">
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title" id="testingModalTitle"></h5>
        <button
          class="close text-white"
          type="button"
          data-dismiss="modal"
          aria-label="Close"
        >
          <span aria-hidden="true">&times;</span>
        </button>
      </div>

      <form id="testingForm" novalidate>
        <div class="modal-body">
          <input type="hidden" id="testingId" />

          <div class="form-group">
            <label
              for="customerName"
              class="small font-weight-bold text-gray-800"
              >Customer Name</label
            >
            <input
              type="text"
              class="form-control"
              id="customerName"
              placeholder="e.g. Dos Cajano"
              required
            />
            <div class="invalid-feedback">Customer Name is required.</div>
          </div>

          <div class="form-row">
            <div class="form-group col-md-7">
              <label
                for="order"
                class="small font-weight-bold text-gray-800"
                >Order</label
              >
              <input
                type="text"
                class="form-control"
                id="order"
                placeholder="e.g. Matcha Latte"
                required
              />
              <div class="invalid-feedback">Order is required.</div>
            </div>
            <div class="form-group col-md-5">
              <label
                for="paymentMethod"
                class="small font-weight-bold text-gray-800"
                >Mode of Payment</label
              >
              <select class="form-control" id="paymentMethod" required>
                <option value="">Mode of Payment</option>
                <option>Cash</option>
                <option>Gcash</option>
                <option>Bank Transfer</option>
              </select>
              <div class="invalid-feedback">
                Please select your mode of payment.
              </div>
            </div>
          </div>

          <div class="form-group mb-0">
            <label for="total" class="small font-weight-bold text-gray-800"
              >Total</label
            >
            <input
              type="total"
              class="form-control"
              id="total"
              placeholder=total"
              required
            />
            <div class="invalid-feedback" id="total">
              Please settle your bills.
            </div>
          </div>
        </div>

        <div class="modal-footer">
          <button class="btn btn-secondary" type="button" data-dismiss="modal">
            Cancel
          </button>
          <button class="btn btn-primary" type="submit" id="orderBtn">
            <i class="fas fa-save mr-1"></i>Save
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
